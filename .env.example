# Copie para .env e preencha. NÃO COMMITAR.
# .env está no .gitignore — credenciais ficam só na sua máquina.

# Webhook do Google Chat. Contém uma chave/token que dá acesso de escrita ao space.
XAVIER_WEBHOOK_URL=

# Credenciais do Mercado Livre (login automático).
# Sem isso, o monitor aborta com "needs_login" se a sessão expirar.
# Atenção: se o ML pedir captcha ou 2FA, o auto-login falha e você recebe
# webhook avisando — você terá que logar manualmente uma vez (xavier login).
XAVIER_ML_EMAIL=
XAVIER_ML_PASSWORD=
